 __global__ void __launch_bounds__(BLOCK_X*BLOCK_Y) renderIndirect(const uint32_t* ids,const uint2* ranges,const uint32_t* point_list,int W,int H,const float2* means2D,const float* colors,const float4* conic_opacity,float* final_T,uint32_t* n_contrib,const float* bg_color,float* out_color){uint32_t t=ids[blockIdx.y*gridDim.x+blockIdx.x];renderTile<NUM_CHANNELS>(t,ranges,point_list,W,H,means2D,colors,conic_opacity,final_T,n_contrib,bg_color,out_color);}
-__global__ void __launch_bounds__(BLOCK_X*BLOCK_Y) renderQueue(const uint32_t* ids,const uint32_t* offsets,uint32_t* counter,int bundles,const uint2* ranges,const uint32_t* point_list,int W,int H,const float2* means2D,const float* colors,const float4* conic_opacity,float* final_T,uint32_t* n_contrib,const float* bg_color,float* out_color){__shared__ uint32_t b;for(;;){if(threadIdx.x==0&&threadIdx.y==0)b=atomicAdd(counter,1u);__syncthreads();if(b>=bundles)return;for(uint32_t at=offsets[b];at<offsets[b+1];at++){renderTile<NUM_CHANNELS>(ids[at],ranges,point_list,W,H,means2D,colors,conic_opacity,final_T,n_contrib,bg_color,out_color);__syncthreads();}}}
+__global__ void __launch_bounds__(BLOCK_X*BLOCK_Y) renderQueue(
+    const uint32_t* ids, const uint32_t* offsets, uint32_t* counter, int bundles,
+    const uint2* ranges, const uint32_t* point_list, int W, int H,
+    const float2* means2D, const float* colors, const float4* conic_opacity,
+    float* final_T, uint32_t* n_contrib, const float* bg_color, float* out_color)
+{
+    __shared__ uint32_t claimed;
+    for (;;) {
+        if (threadIdx.x == 0 && threadIdx.y == 0)
+            claimed = atomicAdd(counter, 1u);
+        __syncthreads();
+        const uint32_t bundle = claimed;
+        if (bundle >= static_cast<uint32_t>(bundles)) return;
+        // Freeze bounds per thread; no loop condition reads a mutable shared claim.
+        const uint32_t first = offsets[bundle];
+        const uint32_t last = offsets[bundle + 1];
+        for (uint32_t at = first; at < last; ++at) {
+            renderTile<NUM_CHANNELS>(ids[at], ranges, point_list, W, H, means2D,
+                colors, conic_opacity, final_T, n_contrib, bg_color, out_color);
+            __syncthreads();
+        }
+        // All warps must leave the old bundle before lane 0 overwrites claimed.
+        __syncthreads();
+    }
+}
+
 int schedule_occupancy(){int result=0;cudaError_t e=cudaOccupancyMaxActiveBlocksPerMultiprocessor(&result,renderQueue,BLOCK_X*BLOCK_Y,0);return e==cudaSuccess?result:1;}
 void schedule_render(dim3 grid,dim3 block,const uint2* ranges,const uint32_t* point_list,int W,int H,const float2* means2D,const float* colors,const float4* conic_opacity,float* final_T,uint32_t* n_contrib,const float* bg_color,float* out_color){if(schedule_config.executor==0)renderIndirect<<<grid,block>>>(schedule_ids,ranges,point_list,W,H,means2D,colors,conic_opacity,final_T,n_contrib,bg_color,out_color);else renderQueue<<<schedule_config.workers,block>>>(schedule_ids,schedule_offsets,schedule_counter,schedule_bundle_count,ranges,point_list,W,H,means2D,colors,conic_opacity,final_T,n_contrib,bg_color,out_color);}
 
