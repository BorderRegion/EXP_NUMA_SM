[Unit]
Description=Tesla T10 quiet power profile at 125 W
Wants=nvidia-persistenced.service
After=systemd-modules-load.service nvidia-persistenced.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi -i GPU-8cfbc08d-0090-bc29-db9a-b2a2f7261ca5 -pm 1
ExecStart=/usr/bin/nvidia-smi -i GPU-8cfbc08d-0090-bc29-db9a-b2a2f7261ca5 -pl 125
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
